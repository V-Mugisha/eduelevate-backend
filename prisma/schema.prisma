generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum GradeLevel {
  S4
  S5
  S6
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String   @map("password_hash")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  isActive      Boolean  @default(true) @map("is_active")
  roleId        String   @map("role_id") @db.Uuid
  role          Role     @relation(fields: [roleId], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  studentProfile  StudentProfile?
  educatorProfile EducatorProfile?
  courses         Course[]
  enrollments     Enrollment[]
  submissions     Submission[]
  certificates    Certificate[]
  mentorshipProfile MentorshipProfile?
  mentorshipApplicationsSent     MentorshipApplication[]  @relation("SentApplications")
  mentorshipApplicationsReceived MentorshipApplication[]  @relation("ReceivedApplications")
  mentorshipsAsStudent Mentorship[] @relation("StudentMentorships")
  mentorshipsAsEducator Mentorship[] @relation("EducatorMentorships")
  sentMessages       MentorshipMessage[]
  auditLogs          AuditLog[]

  @@map("users")
}

model StudentProfile {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @unique @map("user_id") @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolName String     @map("school_name")
  grade      GradeLevel
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("student_profiles")
}

model EducatorProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isIndependent    Boolean  @default(false) @map("is_independent")
  organizationName String?  @map("organization_name")
  expertiseAreas   String[] @map("expertise_areas")
  yearsOfExperience Int?    @map("years_of_experience")
  bio              String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("educator_profiles")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users             User[]
  rolePermissions   RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  role         Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  performedBy String?  @map("performed_by") @db.Uuid
  performer   User?    @relation(fields: [performedBy], references: [id], onDelete: SetNull)
  details     Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  status      String   @default("success")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([createdAt])
  @@map("audit_logs")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  courses Course[]

  @@map("categories")
}

model Course {
  id           String    @id @default(uuid()) @db.Uuid
  title        String
  subtitle     String?
  description  String
  categoryId   String    @map("category_id") @db.Uuid
  category     Category  @relation(fields: [categoryId], references: [id])
  level        String    @default("beginner")
  duration     String?
  isPublished  Boolean   @default(false) @map("is_published")
  maxStudents  Int?      @map("max_students")
  createdBy    String    @map("created_by") @db.Uuid
  creator      User      @relation(fields: [createdBy], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([categoryId])
  modules Module[]
  enrollments Enrollment[]
  certificates Certificate[]

  @@index([createdBy])
  @@map("courses")
}

model Module {
  id            String   @id @default(uuid()) @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  subtitle      String?
  description   String?  @db.Text
  prerequisites String[] @default([])
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lessons Lesson[]

  @@index([courseId])
  @@map("chapters")
}

model Lesson {
  id        String   @id @default(uuid()) @db.Uuid
  moduleId  String   @map("chapter_id") @db.Uuid
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  subtitle  String?
  content   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assessment Assessment?

  @@index([moduleId])
  @@map("topics")
}

model Enrollment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  completedLessons LessonCompletion[]

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonCompletion {
  id           String     @id @default(uuid()) @db.Uuid
  enrollmentId String     @map("enrollment_id") @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String     @map("lesson_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([enrollmentId, lessonId])
  @@map("lesson_completions")
}

model Assessment {
  id           String   @id @default(uuid()) @db.Uuid
  lessonId     String   @unique @map("lesson_id") @db.Uuid
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String?  @db.Text
  instructions String?  @db.Text
  isGraded     Boolean  @default(true) @map("is_graded")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  questions Question[]

  @@map("assessments")
}

model Question {
  id             String     @id @default(uuid()) @db.Uuid
  assessmentId   String     @map("assessment_id") @db.Uuid
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  title          String   @db.Text
  answerOptions  String[]   @map("answer_options")
  correctAnswers String[]   @map("correct_answers")
  grade          Int        @default(1)
  order          Int        @default(0)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  submissions Submission[]

  @@index([assessmentId])
  @@map("questions")
}

model Submission {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId      String   @map("question_id") @db.Uuid
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  providedAnswers String[] @map("provided_answers")
  correctAnswers  String[] @map("correct_answers")
  isCorrect       Boolean  @map("is_correct")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([userId, questionId])
  @@map("submissions")
}

model Certificate {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt  DateTime @default(now()) @map("issued_at")

  @@unique([userId, courseId])
  @@map("certificates")
}

model MentorshipProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics    String[]
  bio       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mentorship_profiles")
}

model MentorshipApplication {
  id              String   @id @default(uuid()) @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  educatorId      String   @map("educator_id") @db.Uuid
  student         User     @relation("SentApplications", fields: [studentId], references: [id], onDelete: Cascade)
  educator        User     @relation("ReceivedApplications", fields: [educatorId], references: [id], onDelete: Cascade)
  message         String
  topic           String?
  status          String   @default("pending")
  rejectionReason String?  @map("rejection_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("mentorship_applications")
}

model Mentorship {
  id          String    @id @default(uuid()) @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  educatorId  String    @map("educator_id") @db.Uuid
  student     User      @relation("StudentMentorships", fields: [studentId], references: [id], onDelete: Cascade)
  educator    User      @relation("EducatorMentorships", fields: [educatorId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  endedBy     String?   @map("ended_by")
  endReason   String?   @map("end_reason")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([studentId, educatorId])
  @@map("mentorships")
  messages MentorshipMessage[]
  rating   MentorshipRating?
}

model MentorshipMessage {
  id           String     @id @default(uuid()) @db.Uuid
  mentorshipId String     @map("mentorship_id") @db.Uuid
  mentorship   Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  senderId     String     @map("sender_id") @db.Uuid
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content      String
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([mentorshipId, createdAt])
  @@map("mentorship_messages")
}

model MentorshipRating {
  id           String     @id @default(uuid()) @db.Uuid
  mentorshipId String     @unique @map("mentorship_id") @db.Uuid
  mentorship   Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  studentId    String     @map("student_id") @db.Uuid
  educatorId   String     @map("educator_id") @db.Uuid
  rating       Int
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("mentorship_ratings")
}
